{
  "dataset": {
    "drop_columns": [],
    "group_column": "subject",
    "holdout_fraction": 0.25,
    "kind": "uci_har",
    "path": "data/UCI HAR Dataset",
    "split_strategy": "official",
    "target_column": "activity"
  },
  "evaluation": {
    "bootstrap_replicates": 300,
    "folds": 3,
    "n_jobs": 1,
    "primary_metric": "macro_f1",
    "seed": 42
  },
  "models": {
    "models": [
      "dummy",
      "logistic_regression",
      "decision_tree",
      "random_forest",
      "rbf_svm"
    ],
    "search_iterations": 6,
    "selection_tolerance": 0.005
  },
  "preprocessing": {
    "categorical_imputer": "most_frequent",
    "numeric_imputer": "median",
    "scale_linear": true
  }
}
